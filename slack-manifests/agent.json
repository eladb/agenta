{
  "display_information": {
    "name": "agenta",
    "description": "Slack thread-backed agentic sandbox bot",
    "background_color": "#1f1f1f"
  },
  "features": {
    "bot_user": {
      "display_name": "agenta",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:history",
        "files:read",
        "files:write",
        "reactions:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
