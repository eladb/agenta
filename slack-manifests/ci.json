{
  "display_information": {
    "name": "agenta-ci",
    "description": "Agenta CI bot — drives e2e tests against the workspace from GitHub Actions",
    "background_color": "#1f1f1f"
  },
  "features": {
    "bot_user": {
      "display_name": "agenta-ci",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write", "channels:history", "files:read", "files:write", "reactions:write", "users:read", "users:read.email"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
