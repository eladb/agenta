# For `bun run setup` — generate at https://api.slack.com/reference/manifests#config-tokens
# (only needed when creating/updating/deleting the Slack apps, not at runtime)
SLACK_CONFIG_ACCESS_TOKEN=xoxe.xoxp-...
SLACK_CONFIG_REFRESH_TOKEN=xoxe-...

# ── Bot (`bun run start:bot`) ──────────────────────────────────────────────
# Slack ingress: opens Socket Mode, acks events, routes to tenants per
# config/tenants.json. No disk writes, no model calls, no Slack ops beyond ack.
SLACK_APP_TOKEN=xapp-...     # bot-only: xapp- for Socket Mode
SLACK_BOT_TOKEN=xoxb-...     # bot-only: xoxb- forwarded to tenants in each envelope
TENANTS_JSON_PATH=./config/tenants.json   # bot-only: defaults to <repo>/config/tenants.json
# Plus one env var PER TENANT named by `tenants[<name>].auth_env` in tenants.json
# (the bearer the bot uses when calling that tenant's /events). E.g.:
# AGENTALABS_TENANT_SECRET=<random shared secret, must match the tenant's TENANT_SECRET>

# ── Tenant (`bun run start:tenant`) ───────────────────────────────────────
# Agent harness: sessions, sandboxes, the Claude Agent SDK turn, JSONL store,
# git transport. Bound to one data volume; serves bot-dispatched /events.
TENANT_SECRET=...            # tenant-only: matches the bot's per-tenant auth_env value
# The turn runs on the Claude Agent SDK (Claude-only). Pick ONE backend — the
# SDK reads these from the process env:
#   Bedrock (prod):  AWS_BEARER_TOKEN_BEDROCK + AWS_REGION + MODEL_NAME=bedrock://us.anthropic.claude-...
#   Anthropic:       ANTHROPIC_API_KEY        + MODEL_NAME=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-... # tenant-only: Anthropic backend (omit when using Bedrock)
# AWS_BEARER_TOKEN_BEDROCK=...                       # tenant-only: Bedrock backend
# AWS_REGION=us-east-1                               # tenant-only: Bedrock backend
# MODEL_NAME=claude-sonnet-4-6                       # tenant-only: model id (or bedrock://...)
# SYSTEM_PROMPT="You are agenta, a helpful assistant..."  # tenant-only
# GITHUB_TOKEN=ghp_...        # tenant-only: PAT for the default https home (Fly secret in prod)
# Plus any per-channel home `auth_env` referenced from tenants.json — the bot
# forwards the NAME of the env var, the tenant resolves it locally. E.g.:
# AGENTA_TEST_HOME_ALONE_DEPLOY_KEY=<ssh deploy-key PEM>

# ── E2E (helpers boot bot + tenant in-process against real Slack) ─────────
TEST_APP_TOKEN=xapp-...
TEST_BOT_TOKEN=xoxb-...
TEST_CHANNEL_ID=C0123456789
