# For `bun run setup` — generate at https://api.slack.com/reference/manifests#config-tokens
# (only needed when creating/updating/deleting the Slack apps, not at runtime)
SLACK_CONFIG_ACCESS_TOKEN=xoxe.xoxp-...
SLACK_CONFIG_REFRESH_TOKEN=xoxe-...

# Populated by `bun run setup` — runtime tokens for the agent + tester bots
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

TEST_APP_TOKEN=xapp-...
TEST_BOT_TOKEN=xoxb-...
TEST_CHANNEL_ID=C0123456789

# Model gateway (Anthropic via OpenAI-compatible endpoint)
ANTHROPIC_API_KEY=sk-ant-...
# MODEL_NAME=claude-sonnet-4-6
# MODEL_BASE_URL=https://api.anthropic.com/v1
# SYSTEM_PROMPT="You are agenta, a helpful assistant..."

# Botspace repo (set as Fly secret in production; not needed for local `bun start`
# against a checked-out working tree).
# GITHUB_TOKEN=ghp_...
# BOTSPACE_REPO=eladb/agenta-test-home
