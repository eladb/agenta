    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.15.2",
    "file-type": "^22.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
