{
  "name": "agenta",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --env-file=.env.dev src/index.ts",
    "test": "bun test src",
    "e2e": "bun scripts/run-e2e.ts",
    "e2e:dev": "bun --env-file=.env.dev scripts/run-e2e.ts",
    "canary": "bun scripts/canary.ts",
    "setup": "bun run scripts/setup-slack-apps.ts",
